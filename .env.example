# ---- AWS credentials (the IAM user's access key pair) ----
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# ---- Amazon Bedrock: the chat model ----
# For newer Claude models this must be the INFERENCE PROFILE ID,
# e.g. us.anthropic.claude-sonnet-4-6
AWS_MODEL_BEDROCK_ID=
# The same model's ARN. The region is read from it.
AWS_BEDROCK_ARN=

# ---- Amazon Bedrock Guardrail (prompt-attack check) ----
BEDROCK_GUARDRAIL_ID=
BEDROCK_VERSION=1

# ---- Region (must match the region inside AWS_BEDROCK_ARN) ----
AWS_REGION=us-east-1

# ---- Amazon RDS for PostgreSQL (two databases on one instance) ----
DATA_DB_URL=postgresql://fundgraph:CHANGE_ME@your-db.xxxxx.us-east-1.rds.amazonaws.com:5432/mf_data
AGENT_DB_URL=postgresql://fundgraph:CHANGE_ME@your-db.xxxxx.us-east-1.rds.amazonaws.com:5432/agent_meta

# ---- Amazon Neptune (the graph) ----
# Reached through the SSM tunnel, so the address stays localhost.
NEPTUNE_ENDPOINT=https://localhost:8182
# The real cluster address: used when signing requests and by the tunnel script.
NEPTUNE_CLUSTER_HOST=
NEPTUNE_PORT=8182

# ---- Tracing (optional) ----
OTEL_SERVICE_NAME=fundgraph-api

# ---- LangSmith (optional, development only) ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=fundgraph-aws-dev
