        "sql": "WITH scheme_metrics AS (SELECT s.scheme_name, SUM(CASE WHEN t.txn_type IN ('Redemption', 'Switch Out') THEN -t.amount ELSE t.amount END) AS net_flows, COUNT(CASE WHEN t.txn_type = 'Redemption' THEN 1 END) AS redemptions_count, SUM(CASE WHEN t.txn_type = 'Redemption' THEN t.amount ELSE 0 END) AS redemptions_value, AVG(CASE WHEN t.txn_status = 'Rejected' THEN 1.0 ELSE 0 END) * 100 AS rejection_rate, COUNT(CASE WHEN sr.sip_status = 'Cancelled' THEN 1 END) AS sip_cancellations, sam.aum_amount FROM transactions t JOIN scheme_plans sp ON t.plan_id = sp.plan_id JOIN schemes s ON sp.scheme_id = s.scheme_id LEFT JOIN folios f ON t.folio_id = f.folio_id LEFT JOIN sip_registrations sr ON f.folio_id = sr.folio_id LEFT JOIN scheme_aum_monthly sam ON s.scheme_id = sam.scheme_id AND sam.month_end_date = (SELECT MAX(month_end_date) FROM scheme_aum_monthly WHERE scheme_id = s.scheme_id AND month_end_date <= '2024-03-31') WHERE s.scheme_name = 'Sahyadri Credit Risk Fund' AND t.txn_date BETWEEN '2024-02-01' AND '2024-03-31' AND t.txn_status = 'Completed' GROUP BY s.scheme_name, sam.aum_amount) SELECT scheme_name, net_flows, redemptions_count, redemptions_value, rejection_rate, sip_cancellations, aum_amount FROM scheme_metrics",
        "commentary": "In March 2024, the Sahyadri Credit Risk Fund saw net outflows of 2.17 crore rupees. There were 242 redemptions totaling 3.84 crore rupees. The rejection rate was 0%, and there were no SIP cancellations. The Assets Under Management (AUM) stood at 197.62 crore rupees. These figures highlight a significant drop in net flows alongside a notable increase in redemptions.",
